<Project>
  <!-- Single source of version truth for all ComputeWarden projects. Bumped by release.ps1. -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <Product>ComputeWarden</Product>
    <Company>RelentlessOldMan</Company>
    <Authors>RelentlessOldMan</Authors>
    <!-- Keep local build paths out of the shipped binaries and PDBs. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
</Project>
